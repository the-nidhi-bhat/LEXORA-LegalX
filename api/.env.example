# LEGALX API environment template. Copy to api/.env and adjust.
# Never commit a filled-in copy (.env is gitignored).

# dev | test | production
APP_ENV=dev

# Development/test default is SQLite. Production REQUIRES postgresql://
# DATABASE_URL=postgresql+psycopg://legalx:change-me@localhost:5432/legalx
DATABASE_URL=sqlite:///./legalx.db

LOG_LEVEL=INFO

# Session cookie (P0-03): HttpOnly + SameSite=Lax, Secure automatically in production.
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_DAYS=7

# CSRF header required on every non-GET request that carries a session.
CSRF_HEADER_NAME=X-CSRF-Token

# Explicit allow-list only; "*" is rejected by configuration validation.
# Empty = no CORS middleware (same-origin via the Vite proxy in dev).
CORS_ORIGINS=

# Demo-only tamper route for the ₹50,000 → ₹5,000 scenario (decision N-05).
# Must be false in production (enforced at startup).
DEMO_TAMPER_ENDPOINT=false

# Deterministic-first IR (decision D-10). Gemini stays off in P0.
FEATURE_AI_EXTRACTION=false

# Login brute-force protection: attempts per window per (email, IP).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
