# LEGALX environment variables — NAMES ONLY, no real values.
# Verified against api/app/config.py and src/api/config.ts. Never commit secrets.

# ---- Backend (FastAPI) ----
# Runtime environment. 'production' hard-rejects non-PostgreSQL DATABASE_URL.
APP_ENV=development

# PostgreSQL connection string (SQLAlchemy 2.x + psycopg). REQUIRED in production.
# Format: postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
# In Vercel this is set as a Sensitive Preview/Production Secret — never here.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/legalx

# Comma-separated allowed CORS origins (only applied when configured).
CORS_ORIGINS=

# Optional demo-only tamper endpoint flag (no consumer route in production).
DEMO_TAMPER_ENDPOINT=false

# Application log level.
LOG_LEVEL=INFO

# Session lifetime controls (hours / absolute days).
SESSION_TTL_HOURS=12
SESSION_ABSOLUTE_DAYS=30

# Optional AI-extraction feature flag (no consumer route; deferred integration).
FEATURE_AI_EXTRACTION=false

# Login rate limiting (per-instance in-memory limiter).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Optional server-side Gemini integration (IMPLEMENTED-BUT-UNWIRED: no HTTP
# route/UI caller; setting a key alone does NOT enable live AI in the app).
# Never place in Vite frontend bundles. Leave blank unless explicitly authorized.
GEMINI_API_KEY=
LEGALX_GEMINI_MODEL=

# ---- Frontend (Vite) ----
# Optional API base override; default is same-origin relative /api/v1.
VITE_API_BASE_URL=

# NOTE: Blockchain / Sepolia / wallet / deployer keys, Supabase, and Etherscan
# settings are OUT OF SCOPE / deferred and are intentionally NOT listed here.
